{
  "name": "@fadhilp/stateql",
  "version": "0.17.0",
  "description": "Stateful, agent-oriented database CLI for safe result reuse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FadhilP/stateql.git"
  },
  "type": "module",
  "bin": {
    "stql": "dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "docs",
    "skills",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "lint": "biome lint",
    "release": "npm version",
    "version": "npm install",
    "prepack": "npm test"
  },
  "keywords": [
    "database",
    "mysql",
    "sqlite",
    "postgresql",
    "cli",
    "agents",
    "redis",
    "sql"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.16"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.1",
    "@redis/client": "^5.12.1",
    "bson": "^6.10.4",
    "mongodb": "^6.21.0",
    "mysql2": "^3.23.1",
    "node-sql-parser": "^5.4.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "node-pty": "^1.1.0",
    "typescript": "^7.0.0"
  }
}
